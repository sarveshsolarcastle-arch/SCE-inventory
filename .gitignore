# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is how a new deploy learns what to set
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
/dev.db
/dev.db-journal
/backups

# agent tooling (vendored skill docs, regenerated automatically)
/.agents
/.windsurf
/.claude/skills
/.claude/settings.local.json
/skills-lock.json

# vendored third-party brand design systems — 147 files of reference material
# dropped in during the Phase 7 UI overhaul. Nothing in the app references them,
# and they are expensive to remove from history once committed.
/design-md
