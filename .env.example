# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# Every variable the app reads is listed here. There are only four that matter,
# and two of them will let the app start in a broken state if you get them wrong,
# so read the notes.

# ---------------------------------------------------------------------------
# DATABASE_URL — required in production, no exceptions.
#
# The app REFUSES TO START without this when NODE_ENV=production. That refusal
# is deliberate: the old behaviour fell back to a local file, so a server with
# this unset came up "fine" against an empty database and lost every write with
# no error anywhere. See src/lib/databaseUrl.ts.
#
# provider = "sqlite" end to end — see REDESIGN-PLAN.md's Phase 8 section for
# why Postgres was rejected for both the pilot and production.
#
# Local development (SQLite, the current setup):
DATABASE_URL="file:./dev.db"
#
# Part A, the hosted pilot (Turso — libSQL, SQLite-compatible) — take this
# from the Turso dashboard:
# DATABASE_URL="libsql://YOUR-DB-NAME.turso.io"

# ---------------------------------------------------------------------------
# TURSO_AUTH_TOKEN — required only when DATABASE_URL is a libsql:// URL
# (Part A). Unused, and safe to leave unset, for the local SQLite file and
# for Part B's offline drive. Treat it as a credential — it grants access to
# the live database.
# TURSO_AUTH_TOKEN="generate-in-the-turso-dashboard"

# ---------------------------------------------------------------------------
# AUTH_SECRET — required. Signs the session JWTs.
#
# Generate a fresh one per environment. NEVER reuse the development value in
# production: anyone holding it can forge a session for any account, including
# ADMIN.
#
#   npx auth secret          # writes one into .env for you
#   openssl rand -base64 32  # or generate manually
AUTH_SECRET="generate-your-own-do-not-copy-this-line"

# ---------------------------------------------------------------------------
# AUTH_TRUST_HOST — set to true when the app runs behind a reverse proxy
# (Caddy, nginx, or any hosting platform's router).
#
# NextAuth v5 otherwise rejects the forwarded host or builds callback URLs
# pointing at localhost, which shows up as a login page that loops forever
# rather than as an error. Not needed when running directly on localhost.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# PORT — optional. `next start` defaults to 3000.
# PORT=3000
